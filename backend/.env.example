PORT=3001
HOST=0.0.0.0

# PostgreSQL. En Neon, usa la cadena de conexión directa (sin "-pooler") con ?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gestor_carteras?schema=public"

# Secreto para firmar los JWT: usa un valor largo y aleatorio (p. ej. `openssl rand -base64 48`)
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN=7d

# Origen del frontend, sin barra final. Se usa para CORS y para el enlace del email de recuperación.
# Sin definir se permite cualquier origen (solo desarrollo/demo).
FRONTEND_URL=http://localhost:5173

# Seed: con "false" carga solo el catálogo de fondos, sin el usuario de demostración (usar en producción).
SEED_DEMO_USER=true

# Datos de mercado (Yahoo Finance)
MARKET_DATA_ENABLED=true
MARKET_DATA_TTL_MINUTES=15
MARKET_DATA_TIMEOUT_MS=3000

# Aportaciones automáticas: cada cuántos minutos se comprueban las vencidas (0 desactiva el temporizador).
CONTRIBUTIONS_CHECK_MINUTES=15
# Opcional: habilita POST /api/cron/contributions/run-due para un cron externo (Authorization: Bearer <CRON_SECRET>).
# CRON_SECRET="un-secreto-largo-y-aleatorio"

# Email de recuperación de contraseña. En producción, SMTP de Brevo (smtp-relay.brevo.com).
# Si SMTP_HOST, SMTP_USER y SMTP_PASS no están definidas se usa una cuenta de pruebas de Ethereal
# (solo desarrollo): el correo no llega a ningún buzón, pero el enlace se imprime en el log.
# SMTP_HOST="smtp-relay.brevo.com"
# SMTP_PORT=2525  (en Render 587/465/25 están bloqueados)
# SMTP_USER="tu_login@smtp-brevo.com"
# SMTP_PASS="tu_clave_smtp_de_brevo"
# Remitente: debe estar verificado en Brevo. Si se omite se usa SMTP_USER.
# SMTP_FROM="Gestor de Carteras <tu_email_de_registro@gmail.com>"
