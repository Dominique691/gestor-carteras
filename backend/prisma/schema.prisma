generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  /// SHA-256 del token de recuperación enviado por email (nunca se guarda el token en claro).
  resetPasswordToken   String?   @unique
  resetPasswordExpires DateTime?

  /// Hasta verificar el email no se puede iniciar sesión.
  isEmailVerified          Boolean   @default(false)
  /// SHA-256 del token de verificación enviado por email (nunca se guarda el token en claro).
  emailVerificationToken   String?   @unique
  emailVerificationExpires DateTime?

  /// Cuenta desechable creada por "Probar demo": se borra pasadas 24 h (con todos sus datos, en cascada).
  isDemo Boolean @default(false)

  transactions      Transaction[]
  targetAllocations TargetAllocation[]
  contributionPlan  ContributionPlan?
  contributionRuns  ContributionRun[]
}

model Fund {
  id         String  @id @default(uuid()) @db.Uuid
  isin       String  @unique
  name       String
  category   String
  currentNAV Decimal @db.Decimal(12, 4)

  /// Símbolo de cotización en Yahoo Finance (p. ej. "EUNL.DE"). Nulo si el fondo no cotiza en bolsa.
  ticker          String?   @unique
  /// Última vez que `currentNAV` se actualizó con datos de mercado. Nulo si nunca se ha sincronizado.
  lastPriceUpdate DateTime?

  transactions      Transaction[]
  targetAllocations TargetAllocation[]
}

enum TransactionType {
  BUY
  SELL
}

model Transaction {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @db.Uuid
  fundId          String          @db.Uuid
  type            TransactionType
  shares          Decimal         @db.Decimal(12, 4)
  pricePerShare   Decimal         @db.Decimal(12, 4)
  transactionDate DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  fund Fund @relation(fields: [fundId], references: [id])

  @@index([userId, transactionDate])
  @@index([fundId])
}

model TargetAllocation {
  userId           String  @db.Uuid
  fundId           String  @db.Uuid
  targetPercentage Decimal @db.Decimal(5, 2)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  fund Fund @relation(fields: [fundId], references: [id])

  @@id([userId, fundId])
}

enum ContributionFrequency {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

/// Aportación periódica automática (una por usuario). Se reparte con el algoritmo de rebalanceo
/// según los objetivos guardados en el momento de ejecutarse.
model ContributionPlan {
  userId    String                @id @db.Uuid
  /// Importe de cada aportación, en €.
  amount    Decimal               @db.Decimal(12, 2)
  frequency ContributionFrequency
  /// Fecha de la primera aportación; las siguientes caen el mismo día del mes (o el último, si no existe).
  startDate DateTime
  /// Próxima ejecución pendiente. Solo se tiene en cuenta si `active`.
  nextRunAt DateTime
  active    Boolean               @default(true)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([active, nextRunAt])
}

enum ContributionRunStatus {
  SUCCESS
  FAILED
}

/// Registro de cada aportación automática ejecutada (o fallida).
model ContributionRun {
  id           String                @id @default(uuid()) @db.Uuid
  userId       String                @db.Uuid
  /// Fecha programada; única por usuario para que una misma aportación no se ejecute dos veces.
  scheduledFor DateTime
  executedAt   DateTime              @default(now())
  amount       Decimal               @db.Decimal(12, 2)
  status       ContributionRunStatus
  /// Número de compras creadas.
  purchases    Int                   @default(0)
  /// Motivo del fallo, si lo hubo.
  message      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scheduledFor])
}
